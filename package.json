{
  "name": "storybook-vue-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Vue 3 + TypeScript component library with Storybook 8 and automated GitHub Pages deployment",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
